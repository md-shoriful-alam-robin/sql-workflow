-- ============================================
-- SHOW VARIABLES — MySQL সেটিং যাচাই
-- ============================================
-- কখন ব্যবহার করবো:
--   Event তৈরির আগে event_scheduler চালু আছে কিনা
--   দেখতে হলে এই কোড চালাও।
--
-- ফলাফল:
--   event_scheduler = ON  → Event চালানো যাবে
--   event_scheduler = OFF → আগে চালু করতে হবে:
--   SET GLOBAL event_scheduler = ON;
-- ============================================
SHOW VARIABLES LIKE 'event%';


-- EVENTS


SELECT *
FROM employee_demographics;

DELIMITER $$

CREATE EVENT delete_retirees
ON SCHEDULE EVERY 30 SECOND
DO
BEGIN
    DELETE 
    FROM employee_demographics
    WHERE age >= 60;
END $$

DELIMITER ;

SHOW VARIABLES LIKE 'event%';
